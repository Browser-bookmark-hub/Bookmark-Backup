{
   "manifest_version": 3,
   "default_locale": "en",
   "name": "__MSG_extensionName__",
   "version": "3.5.8",
   "description": "__MSG_extensionDescription__",
   "author": "kk1",
   "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   },
   "action": {
      "default_icon": {
         "16": "icons/icon16.png",
         "24": "icons/icon24.png",
         "32": "icons/icon32.png"
      },
      "default_title": "__MSG_actionTitle__",
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Ctrl+Shift+U",
            "mac": "Command+Shift+U",
            "windows": "Ctrl+Shift+U",
            "linux": "Ctrl+Shift+U"
         },
         "description": "Activate the extension"
      },
      "open_current_changes_view": {
         "suggested_key": {
            "default": "Ctrl+Shift+I",
            "mac": "Command+Shift+I",
            "windows": "Ctrl+Shift+I",
            "linux": "Ctrl+Shift+I"
         },
         "description": "Open 'Current quantity/structure changes' view"
      },
      "open_backup_history_view": {
         "suggested_key": {
            "default": "Ctrl+Shift+O",
            "mac": "Command+Shift+O",
            "windows": "Ctrl+Shift+O",
            "linux": "Ctrl+Shift+O"
         },
         "description": "Open 'Backup history' view"
      },
      "open_web_snapshot_view": {
         "suggested_key": {
            "default": "Ctrl+Shift+P",
            "mac": "Command+Shift+P",
            "windows": "Ctrl+Shift+P",
            "linux": "Ctrl+Shift+P"
         },
         "description": "Open/close quick Web Snapshot helper on current page"
      }
   },
   "permissions": [
      "bookmarks",
      "storage",
      "unlimitedStorage",
      "alarms",
      "commands",
      "scripting",
      "windows",
      "tabs",
      "tabGroups",
      "downloads",
      "downloads.ui",
      "pageCapture",
      "activeTab",
      "favicon"
   ],
   "host_permissions": [
      "<all_urls>"
   ],
   "web_accessible_resources": [
      {
         "resources": [
            "dev_1/third_party/defuddle.index.full.js",
            "dev_1/third_party/flatten-shadow-dom.js",
            "dev_1/snapshot_highlighter/assets/highlighter.svg",
            "dev_1/snapshot_highlighter/assets/highlighter-red.svg",
            "dev_1/record_worker.js",
            "dev_1/mp4-muxer.js"
         ],
         "matches": [
            "<all_urls>"
         ]
      }
   ]
}
